# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Unlocks /setup, which creates accounts with full privileges.
# Leave blank. Set it only while bootstrapping an admin login, then DELETE it -
# with this unset the route returns 404 and there is nothing to find. Minimum
# 24 characters; anything shorter is ignored.
ADMIN_SETUP_TOKEN=

# Resend
RESEND_API_KEY=
# Where website enquiries are sent
LEAD_NOTIFICATION_TO=
LEAD_NOTIFICATION_FROM=

# Stripe (invoicing, not yet wired)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Blocked on the client: real GA4 measurement id
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
