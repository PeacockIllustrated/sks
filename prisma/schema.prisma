// SKS Construction - data model covering all three phases.
// Tables carry an `sks_` prefix so the schema stays portable into a shared
// Supabase organisation. Profile ids mirror Supabase `auth.users.id`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  STAFF
  CLIENT
}

enum Division {
  CONSTRUCTION
  JOINERY
  ROOFING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  PHONE
  EMAIL
  REFERRAL
  REPEAT
  OTHER
}

enum ProjectStage {
  ENQUIRY
  SURVEY
  QUOTED
  SCHEDULED
  IN_PROGRESS
  SNAGGING
  COMPLETE
  ON_HOLD
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum ReferralStatus {
  RECEIVED
  CONTACTED
  CONVERTED
  REWARDED
  CLOSED
}

enum DocumentKind {
  PHOTO
  DRAWING
  CERTIFICATE
  QUOTE_PDF
  INVOICE_PDF
  CONTRACT
  OTHER
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

/// Mirrors a Supabase auth user. `id` is the auth.users UUID.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  phone     String?
  role      Role     @default(CLIENT)
  jobTitle  String?  @map("job_title")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client            Client?
  ownedLeads        Lead[]            @relation("LeadOwner")
  managedProjects   Project[]         @relation("ProjectManager")
  assignments       Assignment[]
  authoredQuotes    Quote[]           @relation("QuoteAuthor")
  authoredUpdates   ProjectUpdate[]   @relation("UpdateAuthor")
  uploadedDocuments Document[]        @relation("DocumentUploader")
  activity          ActivityLogEntry[]

  @@index([role])
  @@map("sks_profiles")
}

/// A customer. May or may not have a portal login attached.
model Client {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String?  @unique @map("profile_id") @db.Uuid
  companyName  String?  @map("company_name")
  contactName  String   @map("contact_name")
  email        String
  phone        String?
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  postcode     String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile     Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  leads       Lead[]
  projects    Project[]
  quotes      Quote[]
  invoices    Invoice[]
  contracts   MaintenanceContract[]
  referrals   Referral[]           @relation("ReferrerClient")

  @@index([email])
  @@map("sks_clients")
}

// ---------------------------------------------------------------------------
// Phase 2 - pipeline
// ---------------------------------------------------------------------------

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  reference    String     @unique
  clientId     String?    @map("client_id") @db.Uuid
  ownerId      String?    @map("owner_id") @db.Uuid
  name         String
  email        String
  phone        String?
  postcode     String?
  division     Division?
  message      String
  status       LeadStatus @default(NEW)
  source       LeadSource @default(WEBSITE)
  referralId   String?    @unique @map("referral_id") @db.Uuid
  lostReason   String?    @map("lost_reason")
  contactedAt  DateTime?  @map("contacted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner    Profile?  @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  project  Project?

  @@index([status, createdAt])
  @@index([division])
  @@map("sks_leads")
}

model Project {
  id            String       @id @default(uuid()) @db.Uuid
  reference     String       @unique
  clientId      String       @map("client_id") @db.Uuid
  leadId        String?      @unique @map("lead_id") @db.Uuid
  managerId     String?      @map("manager_id") @db.Uuid
  title         String
  division      Division
  stage         ProjectStage @default(ENQUIRY)
  description   String?
  siteAddress   String?      @map("site_address")
  sitePostcode  String?      @map("site_postcode")
  startDate     DateTime?    @map("start_date")
  endDate       DateTime?    @map("end_date")
  contractValue Decimal?     @map("contract_value") @db.Decimal(12, 2)
  isPublished   Boolean      @default(false) @map("is_published")
  slug          String?      @unique
  summary       String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  manager     Profile?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  quotes      Quote[]
  invoices    Invoice[]
  assignments Assignment[]
  updates     ProjectUpdate[]
  documents   Document[]
  contracts   MaintenanceContract[]

  @@index([stage, startDate])
  @@index([division])
  @@index([isPublished])
  @@map("sks_projects")
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  reference   String      @unique
  version     Int         @default(1)
  projectId   String?     @map("project_id") @db.Uuid
  clientId    String      @map("client_id") @db.Uuid
  authorId    String?     @map("author_id") @db.Uuid
  status      QuoteStatus @default(DRAFT)
  title       String
  notes       String?
  terms       String?
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  vatRate     Decimal     @default(20) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount   Decimal     @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  validUntil  DateTime?   @map("valid_until")
  sentAt      DateTime?   @map("sent_at")
  respondedAt DateTime?   @map("responded_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client   Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  author   Profile?        @relation("QuoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  items    QuoteLineItem[]
  invoices Invoice[]

  @@unique([reference, version])
  @@index([status])
  @@map("sks_quotes")
}

model QuoteLineItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  position    Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit        String  @default("item")
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("sks_quote_line_items")
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  reference    String        @unique
  projectId    String?       @map("project_id") @db.Uuid
  quoteId      String?       @map("quote_id") @db.Uuid
  clientId     String        @map("client_id") @db.Uuid
  status       InvoiceStatus @default(DRAFT)
  subtotal     Decimal       @default(0) @db.Decimal(12, 2)
  vatRate      Decimal       @default(20) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount    Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total        Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid   Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  issueDate    DateTime?     @map("issue_date")
  dueDate      DateTime?     @map("due_date")
  paidAt       DateTime?     @map("paid_at")
  stripeIntent String?       @map("stripe_payment_intent_id")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  project  Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote    Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  client   Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items    InvoiceLineItem[]
  payments Payment[]

  @@index([status, dueDate])
  @@map("sks_invoices")
}

model InvoiceLineItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  position    Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit        String  @default("item")
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("sks_invoice_line_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(STRIPE)
  reference     String?
  stripeEventId String?       @unique @map("stripe_event_id")
  receivedAt    DateTime      @default(now()) @map("received_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("sks_payments")
}

// ---------------------------------------------------------------------------
// Phase 2 - scheduling and delivery
// ---------------------------------------------------------------------------

model Assignment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staff   Profile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
  @@index([projectId, startsAt])
  @@map("sks_assignments")
}

/// Progress note. `isClientVisible` is what the Phase 3 portal reads.
model ProjectUpdate {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  authorId        String?  @map("author_id") @db.Uuid
  body            String
  isClientVisible Boolean  @default(false) @map("is_client_visible")
  createdAt       DateTime @default(now()) @map("created_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  Profile? @relation("UpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("sks_project_updates")
}

model Document {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String?      @map("project_id") @db.Uuid
  uploaderId      String?      @map("uploader_id") @db.Uuid
  kind            DocumentKind @default(OTHER)
  title           String
  storagePath     String       @map("storage_path")
  mimeType        String?      @map("mime_type")
  sizeBytes       Int?         @map("size_bytes")
  isClientVisible Boolean      @default(false) @map("is_client_visible")
  createdAt       DateTime     @default(now()) @map("created_at")

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader Profile? @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([projectId, kind])
  @@map("sks_documents")
}

// ---------------------------------------------------------------------------
// Phase 3 - retention
// ---------------------------------------------------------------------------

model MaintenanceContract {
  id                   String         @id @default(uuid()) @db.Uuid
  reference            String         @unique
  clientId             String         @map("client_id") @db.Uuid
  projectId            String?        @map("project_id") @db.Uuid
  title                String
  division             Division?
  status               ContractStatus @default(ACTIVE)
  intervalMonths       Int            @default(12) @map("interval_months")
  amount               Decimal        @db.Decimal(12, 2)
  startDate            DateTime       @map("start_date")
  endDate              DateTime?      @map("end_date")
  nextVisitAt          DateTime?      @map("next_visit_at")
  stripeSubscriptionId String?        @unique @map("stripe_subscription_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, nextVisitAt])
  @@map("sks_maintenance_contracts")
}

model Referral {
  id           String         @id @default(uuid()) @db.Uuid
  referrerId   String?        @map("referrer_id") @db.Uuid
  refereeName  String         @map("referee_name")
  refereeEmail String?        @map("referee_email")
  refereePhone String?        @map("referee_phone")
  note         String?
  status       ReferralStatus @default(RECEIVED)
  rewardAmount Decimal?       @map("reward_amount") @db.Decimal(12, 2)
  rewardedAt   DateTime?      @map("rewarded_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  referrer Client? @relation("ReferrerClient", fields: [referrerId], references: [id], onDelete: SetNull)
  lead     Lead?

  @@index([status])
  @@map("sks_referrals")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

model ActivityLogEntry {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("sks_activity_log")
}

/// Site-wide editable copy and settings, so the client can change strings
/// without a deploy once Phase 2 admin exists.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sks_site_settings")
}
